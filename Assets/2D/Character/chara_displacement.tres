code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D Noise : repeat_enable;



void fragment() {
// Input:14
	vec2 n_out14p0 = UV;


// Input:6
	float n_out6p0 = TIME;


// FloatOp:4
	float n_in4p1 = -0.10000;
	float n_out4p0 = n_out6p0 * n_in4p1;


// FloatOp:16
	float n_in16p1 = -0.10000;
	float n_out16p0 = n_out6p0 * n_in16p1;


// VectorCompose:17
	vec2 n_out17p0 = vec2(n_out4p0, n_out16p0);


// UVFunc:3
	vec2 n_in3p1 = vec2(1.00000, 1.00000);
	vec2 n_out3p0 = n_out17p0 * n_in3p1 + UV;


	vec4 n_out5p0;
// Texture2D:5
	n_out5p0 = texture(Noise, n_out3p0);


// VectorOp:13
	vec2 n_out13p0 = n_out14p0 * vec2(n_out5p0.xy);


// UVFunc:18
	vec2 n_in18p1 = vec2(1.00000, 1.00000);
	vec2 n_out18p0 = n_out13p0 * n_in18p1 + UV;


	vec4 n_out11p0;
// Texture2D:11
	n_out11p0 = texture(TEXTURE, n_out18p0);
	float n_out11p4 = n_out11p0.a;


// Output:0
	COLOR.a = n_out11p4;


}
"
