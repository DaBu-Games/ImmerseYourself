code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D Noise : repeat_enable;



void fragment() {
// Input:14
	vec2 n_out14p0 = SCREEN_UV;


// Input:6
	float n_out6p0 = TIME;


// FloatOp:4
	float n_in4p1 = -2.00000;
	float n_out4p0 = n_out6p0 * n_in4p1;


// FloatOp:23
	float n_in23p1 = 0.50000;
	float n_out23p0 = n_out4p0 * n_in23p1;


// FloatFunc:20
	float n_out20p0 = round(n_out4p0);


// FloatOp:22
	float n_out22p0 = n_out23p0 + n_out20p0;


// FloatOp:16
	float n_in16p1 = -0.10000;
	float n_out16p0 = n_out6p0 * n_in16p1;


// FloatFunc:21
	float n_out21p0 = round(n_out16p0);


// VectorCompose:17
	vec2 n_out17p0 = vec2(n_out22p0, n_out21p0);


// UVFunc:3
	vec2 n_in3p1 = vec2(1.00000, 1.00000);
	vec2 n_out3p0 = n_out17p0 * n_in3p1 + UV;


// UVFunc:19
	vec2 n_in19p1 = vec2(0.10000, 0.10000);
	vec2 n_in19p2 = vec2(0.50000, 0.50000);
	vec2 n_out19p0 = (n_out3p0 - n_in19p2) * n_in19p1 + n_in19p2;


	vec4 n_out5p0;
// Texture2D:5
	n_out5p0 = texture(Noise, n_out19p0);


// VectorOp:13
	vec2 n_out13p0 = n_out14p0 * vec2(n_out5p0.xy);


// UVFunc:18
	vec2 n_in18p1 = vec2(-1.00000, 0.10000);
	vec2 n_out18p0 = n_out13p0 * n_in18p1 + UV;


	vec4 n_out11p0;
// Texture2D:11
	n_out11p0 = texture(TEXTURE, n_out18p0);
	float n_out11p4 = n_out11p0.a;


// Output:0
	COLOR.rgb = vec3(n_out11p0.xyz);
	COLOR.a = n_out11p4;


}
"
